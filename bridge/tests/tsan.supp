# ThreadSanitizer suppressions for the bridge tests.
#
# libQt6Core is not instrumented and QObject posts events across threads with
# futex-based locks, which TSan cannot see. The objects handed over that way (the
# queued std::function and what it captured) are therefore reported as racing
# between the posting thread and the UI thread although Qt orders them.
# Everything the bridge shares itself (the event queue, flags, the waiter state)
# uses std::mutex / std::atomic and stays fully checked: no suppression covers it.
race:libQt6Core.so
race:QtPrivate::QCallableObject
race:QtPrivate::FunctorCall
race:QtPrivate::detail::StorageByValue
race:tkde::Bridge::post
race:tkde::Bridge::query
race:tkde::Bridge::release
race:tkde::Bridge::runOnUi
race:tkde::Bridge::runOnUiAndWait

# The editor tests start KTextEditor/KIO/D-Bus helper threads (QThread::start inside the
# libraries) that Qt only joins at process exit, and libdbus takes two of its own locks in
# both orders on different connections. Both live entirely inside the libraries; the bridge
# takes none of those locks.
thread:QThread::start
deadlock:libdbus-1.so

# The action test simulates key presses with QTest; QWindowSystemInterface hands its event
# objects over inside the uninstrumented libQt6Gui, where TSan only sees the allocator calls.
race:libQt6Gui.so

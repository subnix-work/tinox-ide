import tinox.ide.kde.App
import tinox.ide.kde.Bridge
import tinox.ide.kde.Event
import tinox.ide.kde.EventLoop

class Main
{
    // The logic task. For now it only proves the wiring end to end: when the UI is
    // up it asks the bridge what it is, prints it and quits. The IDE proper (#19)
    // replaces this body.
    fnc onReady(events: EventLoop) -> Nothing
    {
        const caps = Bridge::query("{\"cmd\":\"core.capabilities\"}")
        println("tinox-ide: bridge ABI " + caps.getField("abi").getInt().toString() + ", Qt " + caps.getField("qt").getString() + ", KDE Frameworks " + caps.getField("kf").getString())
        Bridge::quit()
    }

    fnc logic(events: EventLoop) -> Int32
    {
        events.onType("core.ready", (ev: Event) => Main::onReady(events))
        events.run()
        return 0
    }

    fnc main() -> Int32
    {
        return App::run("tinoxide", "Tinox IDE", (events: EventLoop) => Main::logic(events))
    }
}

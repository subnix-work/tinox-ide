module tinox.ide.ui

import tinox.core.json
import tinox.ide.kde.Event

namespace tinox.ide.ui
{
    /**
     * A change of a document as the editor reports it (event "editor.changed"): one per
     * editing step, however many pieces of text it touched.
     *
     * The edits are in the order they happened and each range refers to the text after
     * the one before it, which is exactly how a Language Server expects didChange.
     */
    class Change
    {
        /** The document's version after this change (counts from 0 at creation; loading a file or creating a document with text is version 0). */
        var version: Int64
        /** "user" for typing and other input, "command" for changes made through this API. */
        var origin: String
        /** The changes of this step in order; each range refers to the text after the one before. */
        var edits: List<TextEdit>

        /** Reads an editor.changed event. */
        fnc parse(ev: Event) -> Change
        {
            var edits: List<TextEdit> = []
            const items: List<JsonValue> = ev.field("changes").asList()
            var i: Int64 = 0
            while (i < items.len())
            {
                edits.push(TextEdit::parseChange(items[i]))
                i = i + 1
            }
            return Change { version: ev.int("version"), origin: ev.str("origin"), edits: edits }
        }

        /** Whether the user caused it (as opposed to a call of this API). */
        fn byUser() -> Bool
        {
            return this.origin == "user"
        }
    }
}

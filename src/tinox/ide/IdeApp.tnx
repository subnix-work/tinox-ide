module tinox.ide

import tinox.ide.app.CommandContext
import tinox.ide.app.CommandRegistry
import tinox.ide.app.ErrorReporter
import tinox.ide.app.EventBus
import tinox.ide.app.IdeCommand
import tinox.ide.app.Logger
import tinox.ide.app.MainWindow
import tinox.ide.app.Store
import tinox.ide.lsp.LanguageService
import tinox.ide.kde.App
import tinox.ide.kde.Bridge
import tinox.ide.kde.Event
import tinox.ide.kde.EventLoop
import tinox.ide.editor.Documents
import tinox.ide.search.FindInFiles
import tinox.ide.search.Navigation
import tinox.ide.settings.Preferences
import tinox.ide.settings.SettingsDialog
import tinox.ide.settings.Settings
import tinox.ide.terminal.TerminalPanel
import tinox.ide.ui.Actions
import tinox.ide.ui.Dialogs
import tinox.ide.workspace.Workspace

namespace tinox.ide
{
    /**
     * The application: creates the parts, connects them and starts the window. The parts, from
     * the bottom up:
     *
     *   - EventBus: in-process messages between modules; background tasks join it through Background
     *   - Store: the one application state; written by commands and handlers, read by the UI
     *   - Logger, ErrorReporter: what is written down and what the user sees when something fails
     *   - Actions + CommandRegistry: every command of the IDE, shared by menus, shortcuts and the palette
     *   - MainWindow: the widgets, a function of the store
     *
     * Feature modules (workspace, editor, lsp, build, settings) add commands to the registry,
     * read and write the store, and talk to each other over the bus; none of them calls another
     * directly. See docs/ide-core.md.
     */
    class IdeApp
    {
        /** The loop events arrive on. */
        var events: EventLoop
        /** Messages between modules. */
        var bus: EventBus
        /** The application state. */
        var store: Store
        /** The log. */
        var logger: Logger
        /** Shows failures. */
        var errors: ErrorReporter
        /** The bridge's actions. */
        var actions: Actions
        /** Every command. */
        var registry: CommandRegistry
        /** The window. */
        var window: MainWindow
        /** Dialogs. */
        var dialogs: Dialogs
        /** The open project and its tree. */
        var workspace: Workspace
        /** The open files. */
        var documents: Documents
        /** Quick open and the command palette. */
        var navigation: Navigation
        /** Find and replace in files. */
        var search: FindInFiles
        /** Language-server lifecycle and the shared problems/editor diagnostics. */
        var language: LanguageService
        /** The integrated terminal. */
        var terminal: TerminalPanel
        /** The preferences with their defaults and checks. */
        var preferences: Preferences
        /** The settings window. */
        var settingsDialog: SettingsDialog
        /** The user's persistent settings. */
        var settings: Settings
        /** False once the application is quitting. */
        var running: Bool

        /** Builds the application and shows its window; call it from the core.ready handler. */
        fnc start(events: EventLoop) -> IdeApp
        {
            const logger: Logger = Logger::fromEnvironment()
            logger.forwardToBridge(true)
            const bus: EventBus = EventBus::create()
            bus.attach(events)
            logger.attach(bus)
            const store: Store = Store::create(bus)
            const settings: Settings = Settings::create("")
            const errors: ErrorReporter = ErrorReporter::create(logger, store)
            errors.install(events, bus)
            const actions: Actions = Actions::create(events)
            const registry: CommandRegistry = CommandRegistry::create(store, bus, actions)
            const window: MainWindow = MainWindow::create(events, store, bus, registry, actions)
            const dialogs: Dialogs = Dialogs::create(events)
            const workspace: Workspace = Workspace::create(events, bus, store, registry, actions, dialogs, settings, logger, window.mount)
            const documents: Documents = Documents::create(events, bus, store, registry, dialogs, settings, logger, window)
            const navigation: Navigation = Navigation::create(events, bus, store, registry, settings)
            navigation.openPaths = (s: Store) => documents.paths()
            const search: FindInFiles = FindInFiles::create(events, bus, store, registry, dialogs, window, documents, logger)
            const preferences: Preferences = Preferences::create(settings, store, bus)
            const settingsDialog: SettingsDialog = SettingsDialog::create(events, preferences, actions)
            settingsDialog.themes = (p: Preferences) => documents.themes()
            settingsDialog.editorConfig = (p: Preferences) => documents.showEditorConfig()
            search.install()
            const terminal: TerminalPanel = TerminalPanel::install(window)
            const language: LanguageService = LanguageService::create(window, documents, preferences)
            const app: IdeApp = IdeApp { events: events, bus: bus, store: store, logger: logger, errors: errors, actions: actions, registry: registry, window: window, dialogs: dialogs, workspace: workspace, documents: documents, navigation: navigation, search: search, language: language, terminal: terminal, preferences: preferences, settingsDialog: settingsDialog, settings: settings, running: true }
            app.loadSettings()
            app.registerCommands()
            workspace.registerCommands()
            window.addFileMenu(workspace.menuItems())
            documents.registerCommands()
            window.addFileMenu(documents.fileItems())
            window.addViewMenu(documents.viewItems())
            navigation.registerCommands()
            var go: List<String> = navigation.menuItems()
            go.push("problems.next")
            go.push("problems.previous")
            window.addGoMenu(go, search.menuItems())
            registry.attach()
            app.mirrorChecks()
            window.start()
            workspace.bind()
            documents.bind()
            navigation.bind()
            search.bind()
            language.problems.bind()
            logger.info("Tinox IDE started")
            return app
        }

        /** Initial state: the layout flags come from the settings (visible by default). */
        fn loadSettings() -> Nothing
        {
            this.preferences.load()
            this.store.setBool("ui.projectVisible", this.settings.getBool("MainWindow", "projectVisible", true))
            this.store.setBool("ui.bottomVisible", this.settings.getBool("MainWindow", "bottomVisible", true))
            this.store.set("status.message", "Ready")
        }

        /** The commands of the application core; feature modules register their own. */
        fn registerCommands() -> Nothing
        {
            this.registry.registerAll([
                IdeCommand::standard("options_configure").run((c: CommandContext) => this.settingsDialog.open(-1)),
                IdeCommand::standard("file_quit").run((c: CommandContext) => this.requestQuit()),
                IdeCommand::create("view.project", "Show &Project").icon("view-list-tree").shortcut("Alt+1").category("View").checkable(true).run((c: CommandContext) => this.store.setBool("ui.projectVisible", c.checked)),
                IdeCommand::create("view.bottom", "Show &Problems and Output").icon("view-list-details").shortcut("Alt+2").category("View").checkable(true).run((c: CommandContext) => this.store.setBool("ui.bottomVisible", c.checked))
            ])
        }

        /** Keeps the check marks of the view commands in step with the state and saves the layout flags. */
        fn mirrorChecks() -> Nothing
        {
            this.actions.setChecked("view.project", this.store.getBool("ui.projectVisible"))
            this.actions.setChecked("view.bottom", this.store.getBool("ui.bottomVisible"))
            this.store.watch("ui.projectVisible", (value: String) => this.layoutChanged("view.project", "projectVisible", value))
            this.store.watch("ui.bottomVisible", (value: String) => this.layoutChanged("view.bottom", "bottomVisible", value))
        }

        /** A layout flag changed: check mark and settings follow. */
        fn layoutChanged(command: String, key: String, value: String) -> Nothing
        {
            this.actions.setChecked(command, value == "true")
            this.settings.setBool("MainWindow", key, value == "true")
        }

        /** The user wants to quit: files with unsaved changes ask first; Cancel keeps the application running. */
        fn requestQuit() -> Nothing
        {
            if (!this.running)
            {
                return
            }
            this.documents.confirmQuit((ok: Bool) => this.quitIf(ok))
        }

        /** Quits when nobody objected. */
        fn quitIf(ok: Bool) -> Nothing
        {
            if (ok)
            {
                this.quit()
            }
        }

        /** Saves the layout and ends the program. */
        fn quit() -> Nothing
        {
            if (!this.running)
            {
                return
            }
            this.running = false
            this.logger.info("Tinox IDE is quitting")
            this.language.shutdown()
            this.workspace.shutdown()
            this.documents.shutdown()
            this.search.shutdown()
            try
            {
                this.window.saveState()
            }
            catch (e: String)
            {
                this.logger.warn("could not save the window layout: " + e)
            }
            Bridge::quit()
        }

        /** The logic task: build the application when the UI is up and serve events until shutdown. */
        fnc logic(events: EventLoop) -> Int32
        {
            events.onType("core.ready", (ev: Event) => IdeApp::ready(events))
            events.run()
            return 0
        }

        /** The UI is up: build the application, reopen the project (command line, TINOXIDE_OPEN or the last one). With TINOXIDE_SMOKE=1 (the headless smoke test) the program uses its own Quit command at once. */
        fnc ready(events: EventLoop) -> Nothing
        {
            const app: IdeApp = IdeApp::start(events)
            app.workspace.restore()
            app.documents.restoreSession()
            app.documents.startTicker()
            app.language.start()
            if (Bridge::env("TINOXIDE_SMOKE") == "1")
            {
                app.actions.trigger("file_quit")
            }
        }

        /** The program. */
        fnc main() -> Int32
        {
            return App::run("tinoxide", "Tinox IDE", (events: EventLoop) => IdeApp::logic(events))
        }
    }
}

module tinox.ide.kde

namespace tinox.ide.kde
{
    /**
     * Dispatches bridge events to handlers on the logic task.
     *
     * Handlers are registered by event type ("widget.clicked") and/or by the id of the
     * object an event comes from; both kinds run, type handlers first. One handler per
     * key: registering again replaces it. A handler that throws is recorded and
     * reported on stderr, and the loop carries on with the next event.
     *
     * Use run() as the body of the logic task (ends at core.shutdown or stop()), or
     * pump() to process what is available, for tests and for embedding in other loops.
     */
    class EventLoop
    {
        /** Handlers by event type. */
        var byType: Map<String, fnc(Event) -> Nothing>
        /** Handlers by object id (as text). */
        var byTarget: Map<String, fnc(Event) -> Nothing>
        /** Set by stop(). */
        var stopped: Bool
        /** Set when core.shutdown was seen. */
        var shutdown: Bool
        /** How many events were dispatched. */
        var delivered: Int64
        /** Messages of handlers that threw and of events that could not be read. */
        var failures: List<String>
        /** Told about every failure, e.g. to show an error message to the user. */
        var failureHandler: fnc(String) -> Nothing

        /** A loop with no handlers. */
        fnc create() -> EventLoop
        {
            return EventLoop { byType: Map::new(), byTarget: Map::new(), stopped: false, shutdown: false, delivered: 0, failures: [], failureHandler: (message: String) => EventLoop::ignore() }
        }

        /** Runs `handler` for every event of this type; replaces an earlier one. */
        fn onType(type: String, handler: fnc(Event) -> Nothing) -> Nothing
        {
            this.byType.set(type, handler)
        }

        /** Removes the handler of an event type. */
        fn offType(type: String) -> Nothing
        {
            this.byType.remove(type)
        }

        /** Runs `handler` for every event that comes from the object with this id; replaces an earlier one. */
        fn onTarget(id: Int64, handler: fnc(Event) -> Nothing) -> Nothing
        {
            this.byTarget.set(id.toString(), handler)
        }

        /** Removes the handler of an object. */
        fn offTarget(id: Int64) -> Nothing
        {
            this.byTarget.remove(id.toString())
        }

        /** Makes run() return after the current event. */
        fn stop() -> Nothing
        {
            this.stopped = true
        }

        /** Whether the bridge has ended the event stream (core.shutdown was seen). */
        fn isShutdown() -> Bool
        {
            return this.shutdown
        }

        /** How many failures were recorded. */
        fn failureCount() -> Int64
        {
            return this.failures.len()
        }

        /** Does nothing: the default failure handler. */
        fnc ignore() -> Nothing
        {
        }

        /** Calls `handler` with the message of every failure from now on (after it was recorded and printed). A handler that throws is ignored. */
        fn onFailure(handler: fnc(String) -> Nothing) -> Nothing
        {
            this.failureHandler = handler
        }

        /** Records a failure, prints it on stderr and tells the failure handler; the loop carries on. */
        fn fail(message: String) -> Nothing
        {
            this.failures.push(message)
            printStderr("tinox-ide: " + message)
            try
            {
                this.failureHandler(message)
            }
            catch (e: String)
            {
                printStderr("tinox-ide: the failure handler failed too: " + e)
            }
        }

        /** Runs the handlers for one event. */
        fn dispatch(ev: Event) -> Nothing
        {
            this.delivered = this.delivered + 1
            if (ev.type == "core.shutdown")
            {
                this.shutdown = true
            }
            if (this.byType.contains(ev.type))
            {
                const handler: fnc(Event) -> Nothing = this.byType.get(ev.type)
                try
                {
                    handler(ev)
                }
                catch (e: String)
                {
                    this.fail("handler for " + ev.type + " failed: " + e)
                }
            }
            if (ev.target > 0 && this.byTarget.contains(ev.target.toString()))
            {
                const targetHandler: fnc(Event) -> Nothing = this.byTarget.get(ev.target.toString())
                try
                {
                    targetHandler(ev)
                }
                catch (e: String)
                {
                    this.fail("handler for object " + ev.target.toString() + " (" + ev.type + ") failed: " + e)
                }
            }
        }

        /** Handles one event text; a malformed one is recorded, never fatal. */
        fn handle(text: String) -> Nothing
        {
            try
            {
                const ev: Event = Event::parse(text)
                this.dispatch(ev)
            }
            catch (e: String)
            {
                this.fail("dropped an unreadable event: " + e)
            }
        }

        /**
         * Waits up to timeoutMs for an event, then handles it and everything already
         * queued. Returns how many events it handled (0 on timeout).
         */
        fn pump(timeoutMs: Int64) -> Int64
        {
            var handled: Int64 = 0
            var wait: Int64 = timeoutMs
            while (!this.stopped && !this.shutdown)
            {
                const text: String = Bridge::nextEvent(wait)
                if (text == "")
                {
                    return handled
                }
                this.handle(text)
                handled = handled + 1
                wait = 0
            }
            return handled
        }

        /** Handles events until core.shutdown arrives or stop() is called. */
        fn run() -> Nothing
        {
            while (!this.stopped && !this.shutdown)
            {
                this.pump(200)
            }
        }
    }
}

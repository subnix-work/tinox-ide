module tinox.ide.kde

import tinox.core.json

namespace tinox.ide.kde
{
    /**
     * One event from the bridge (docs/abi.md): the envelope fields are parsed once
     * when the event is created; the rest stays available through the typed accessors.
     */
    class Event
    {
        /** The event type, "namespace.name". */
        var type: String
        /** Strictly increasing sequence number. */
        var seq: Int64
        /** Timestamp on the bridge's monotonic clock, in nanoseconds. */
        var tNs: Int64
        /** Id of the object the event comes from, 0 when it has none. */
        var target: Int64
        /** The event as received, JSON text. */
        var raw: String
        /** The parsed event. */
        var json: JsonValue

        /** Parses event JSON text; throws a String when it is not an event object. */
        fnc parse(text: String) -> Event
        {
            const json: JsonValue = Json::parse(text)
            if (!json.isObject())
            {
                throw "event is not a JSON object: " + text
            }
            const type: JsonValue = json.getField("type")
            if (!type.isString())
            {
                throw "event has no string \"type\": " + text
            }
            var target: Int64 = 0
            const targetField: JsonValue = json.getField("target")
            if (targetField.isInt())
            {
                target = targetField.getInt()
            }
            return Event { type: type.getString(), seq: json.getField("seq").getInt(), tNs: json.getField("t_ns").getInt(), target: target, raw: text, json: json }
        }

        /** Whether the event has a non-null field `key`. */
        fn has(key: String) -> Bool
        {
            return !this.json.getField(key).isNull()
        }

        /** A string field ("" when absent). */
        fn str(key: String) -> String
        {
            return this.json.getField(key).getString()
        }

        /** An integer field (0 when absent). */
        fn int(key: String) -> Int64
        {
            return this.json.getField(key).getInt()
        }

        /** A boolean field (false when absent). */
        fn bool(key: String) -> Bool
        {
            return this.json.getField(key).getBool()
        }

        /** Any field as parsed JSON, for arrays and objects. */
        fn field(key: String) -> JsonValue
        {
            return this.json.getField(key)
        }
    }
}

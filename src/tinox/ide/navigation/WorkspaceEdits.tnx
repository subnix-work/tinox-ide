module tinox.ide.navigation

import tinox.core.json
import tinox.ide.editor.Documents
import tinox.ide.editor.OpenFile
import tinox.ide.kde.Bridge
import tinox.ide.kde.Command
import tinox.ide.ui.Js
import tinox.ide.ui.Range
import tinox.ide.ui.TextEdit
import tinox.ide.ui.Utf16

namespace tinox.ide.navigation
{
    /** Shared parsing and native atomic application for rename, formatting and code actions. */
    class WorkspaceEdits
    {
        /** Opens and version-pins text edits; resource operations and malformed edits are rejected. */
        fnc parse(documents: Documents, value: JsonValue) -> List<WorkspaceChange>
        {
            var edits: Map<String, JsonValue> = value.getField("changes").asTable()
            var versions: Map<String, Int64> = Map::new()
            for change in value.getField("documentChanges").asList()
            {
                if (!change.getField("kind").isNull()) { throw "Workspace resource operations are not supported" }
                const uri: String = change.getField("textDocument").getField("uri").getString()
                if (uri == "" || edits.contains(uri)) { throw "Duplicate or missing WorkspaceEdit URI" }
                edits.set(uri, change.getField("edits"))
                if (!change.getField("textDocument").getField("version").isNull()) {
                    if (!change.getField("textDocument").getField("version").isInt()) { throw "WorkspaceEdit version must be an integer or null" }
                    versions.set(uri, change.getField("textDocument").getField("version").getInt()) }
            }
            var preview: List<WorkspaceChange> = []
            for uri in edits.keys()
            {
                const path: String = Location::path(uri)
                const file: OpenFile = documents.open(path)
                const snapshot: JsonValue = file.doc.snapshot()
                const version: Int64 = snapshot.getField("version").getInt()
                if (versions.contains(uri) && versions.get(uri) != version) { throw "Workspace edit is stale" }
                var replacements: List<TextEdit> = []
                if (!edits.get(uri).isArray()) { throw "WorkspaceEdit edits must be an array" }
                for edit in edits.get(uri).asList()
                {
                    const range: Range = Location::span(edit.getField("range"))
                    if (!edit.getField("newText").isString()) { throw "WorkspaceEdit has no replacement text" }
                    Utf16::offset(snapshot.getField("text").getString(), range.start)
                    Utf16::offset(snapshot.getField("text").getString(), range.end)
                    replacements.push(TextEdit::replace(range, edit.getField("newText").getString()))
                }
                preview.push(WorkspaceChange { file: file, version: version, text: snapshot.getField("text").getString(), edits: replacements })
            }
            return preview
        }

        /** Applies one validated multi-document command and returns its inverse. */
        fnc apply(changes: List<WorkspaceChange>) -> JsonValue
        {
            var commands: List<String> = []
            for change in changes { commands.push(change.toJson()) }
            return Bridge::query(Command::named("editor.workspaceEdit").raw("documents", Js::array(commands)).build())
        }
    }
}

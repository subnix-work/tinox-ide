module tinox.ide.build

import tinox.core.json
import tinox.ide.app.MainWindow
import tinox.ide.editor.Documents
import tinox.ide.ui.ItemView
import tinox.ide.ui.Model
import tinox.ide.ui.Row

namespace tinox.ide.build
{
    /**
     * The tree of discovered tests grouped by file, filled from the `test-*` events of
     * `tinox test --message-format=json`. A failed test shows its message lines below it;
     * a line with a `path:line:column` location opens that place, any other the test itself.
     */
    class TestExplorer
    {
        /** The window with the store and the mounted tree. */
        var window: MainWindow
        /** Opens files at a test or a failure location. */
        var documents: Documents
        /** The tree model. */
        var model: Model
        /** Every discovered test. */
        var cases: List<TestCase>
        /** Files and messages the compiler could not collect tests from. */
        var errors: List<String>
        /** The tree needs to be drawn again. */
        var dirty: Bool
        /** The tests before the discovery in progress, restored when it is cancelled or fails. */
        var saved: List<TestCase>
        /** The collection errors before the discovery in progress. */
        var savedErrors: List<String>
        /** What the last finished discovery covered: "" before any, "all tests" or the file. */
        var scope: String
        /** The scope before the discovery in progress. */
        var savedScope: String
        /** Whether a discovery is in progress. */
        var discovering: Bool
        /** The tests and collection errors the discovery in progress has reported. */
        var seen: Int64

        /** Creates the explorer; bind() attaches the tree once the window exists. */
        fnc create(window: MainWindow, documents: Documents) -> TestExplorer
        {
            return TestExplorer { window: window, documents: documents, model: Model::create(window.events, ["Test", "Result", "Time"], false), cases: [], errors: [], dirty: false, saved: [], savedErrors: [], scope: "", savedScope: "", discovering: false, seen: 0 }
        }

        /** Attaches the model and the activation handler to the mounted tree. */
        fn bind() -> Nothing
        {
            this.model.attach(this.window.mount.idOf("tests"))
            this.window.mount.onActivated("tests", (id: String) => this.visit(id))
        }

        /** Forgets the results of a previous run but keeps the discovered tests. */
        fn clearResults() -> Nothing
        {
            for c in this.cases
            {
                c.status = "idle"
                c.message = ""
                c.millis = 0
            }
            this.errors = []
            this.dirty = true
        }

        /** Whether two paths name the same file (the tool reports them relative to the project, the editor has them absolute). */
        fnc same(a: String, b: String) -> Bool
        {
            return a == b || a.endsWith("/" + b) || b.endsWith("/" + a)
        }

        /**
         * A discovery starts: `file` "" covers the whole workspace, else only that file. The tests it
         * covers are dropped and found again; the rest stay. Keep the old state to restore if it fails.
         */
        fn beginDiscovery(file: String) -> Nothing
        {
            this.saved = this.cases
            this.savedErrors = this.errors
            this.savedScope = this.scope
            this.discovering = true
            this.seen = 0
            if (file == "")
            {
                this.cases = []
                this.errors = []
                this.scope = "all tests"
            }
            else
            {
                var kept: List<TestCase> = []
                for c in this.cases
                {
                    if (!TestExplorer::same(c.file, file)) { kept.push(c) }
                }
                this.cases = kept
                var keptErrors: List<String> = []
                for e in this.errors
                {
                    if (!e.startsWith(file + ": ")) { keptErrors.push(e) }
                }
                this.errors = keptErrors
                this.scope = file
            }
            this.window.store.set("tests.scope", this.scope)
            this.dirty = true
        }

        /** The discovery ended: keep what it found, or put the previous tests back (cancelled, failed). */
        fn endDiscovery(keep: Bool) -> Nothing
        {
            if (!this.discovering) { return }
            this.discovering = false
            if (!keep)
            {
                this.cases = this.saved
                this.errors = this.savedErrors
                this.scope = this.savedScope
                this.window.store.set("tests.scope", this.scope)
                this.dirty = true
            }
            this.saved = []
            this.savedErrors = []
        }

        /** The number of tests found in a file. */
        fn countIn(file: String) -> Int64
        {
            var n: Int64 = 0
            for c in this.cases
            {
                if (TestExplorer::same(c.file, file)) { n = n + 1 }
            }
            return n
        }

        /** Forgets everything (a new discovery follows). */
        fn clearAll() -> Nothing
        {
            this.cases = []
            this.errors = []
            this.dirty = true
        }

        /** The index of the test with this id, -1 when unknown. */
        fn indexOf(id: String) -> Int64
        {
            var i: Int64 = 0
            while (i < this.cases.len())
            {
                if (this.cases[i].id() == id) { return i }
                i = i + 1
            }
            return -1
        }

        /** The test an event describes (file, class, method), created on first sight. */
        fn caseOf(event: JsonValue) -> TestCase
        {
            var fresh: TestCase = TestCase { file: RunConfig::text(event, "file"), className: RunConfig::text(event, "class"), method: RunConfig::text(event, "method"), description: RunConfig::text(event, "description"), line: event.getField("line").getInt(), column: event.getField("column").getInt(), status: "idle", message: "", millis: 0 }
            const index: Int64 = this.indexOf(fresh.id())
            if (index >= 0) { return this.cases[index] }
            this.cases.push(fresh)
            return fresh
        }

        /** Applies one JSON event of a test run or listing. */
        fn handle(event: JsonValue) -> Nothing
        {
            const reason: String = RunConfig::text(event, "reason")
            if (this.discovering && (reason == "test-discovered" || reason == "test-collection-error")) { this.seen = this.seen + 1 }
            if (reason == "test-discovered")
            {
                this.caseOf(event)
            }
            else if (reason == "test-started")
            {
                this.caseOf(event).status = "running"
            }
            else if (reason == "test-passed")
            {
                const c: TestCase = this.caseOf(event)
                c.status = "passed"
                c.message = ""
                c.millis = event.getField("duration_ms").getInt()
            }
            else if (reason == "test-failed")
            {
                const c: TestCase = this.caseOf(event)
                c.status = "failed"
                c.message = RunConfig::text(event, "message")
                if (c.message == "") { c.message = RunConfig::text(event, "output") }
                c.millis = event.getField("duration_ms").getInt()
            }
            else if (reason == "test-collection-error")
            {
                var origin: String = RunConfig::text(event, "file")
                if (origin != "") { origin = origin + ": " }
                this.errors.push(origin + RunConfig::text(event, "message"))
            }
            this.dirty = true
        }

        /** Tests still marked running after a task ended (it was killed) go back to idle. */
        fn interrupted() -> Nothing
        {
            for c in this.cases
            {
                if (c.status == "running") { c.status = "idle" }
            }
            this.dirty = true
        }

        /** The number of tests with this status. */
        fn count(status: String) -> Int64
        {
            var n: Int64 = 0
            for c in this.cases
            {
                if (c.status == status) { n = n + 1 }
            }
            return n
        }

        /** The files that contain failed tests, each once. */
        fn failedFiles() -> List<String>
        {
            var out: List<String> = []
            for c in this.cases
            {
                if (c.status == "failed" && !out.contains(c.file)) { out.push(c.file) }
            }
            return out
        }

        /** The file of the selected row (a file group, a test or a failure line), "" when nothing is selected. */
        fn selectedFile() -> String
        {
            const id: String = ItemView::of(this.window.mount, "tests").current()
            if (id.startsWith("file:")) { return id.substring(5, id.len()) }
            const test: TestCase = this.caseOfRow(id)
            return test.file
        }

        /** The test a row id belongs to (a test row, or a failure line "detail:<test id>@<n>"); the first test if none matches. */
        fn caseOfRow(id: String) -> TestCase
        {
            var key: String = id
            if (key.startsWith("detail:"))
            {
                key = key.substring(7, key.len())
                key = key.substring(0, key.lastIndexOf("@"))
            }
            const index: Int64 = this.indexOf(key)
            if (index >= 0) { return this.cases[index] }
            return TestCase { file: "", className: "", method: "", description: "", line: 0, column: 0, status: "idle", message: "", millis: 0 }
        }

        /** "3 passed · 1 failed · 4 tests". */
        fn summary() -> String
        {
            var text: String = this.count("passed").toString() + " passed · " + this.count("failed").toString() + " failed · " + this.cases.len().toString() + " tests"
            if (this.errors.len() > 0) { text = text + " · " + this.errors.len().toString() + " not collected" }
            return text
        }

        /** Rebuilds the tree when something changed. */
        fn flush() -> Nothing
        {
            if (!this.dirty) { return }
            this.dirty = false
            var rows: List<Row> = []
            var files: List<String> = []
            for c in this.cases
            {
                if (!files.contains(c.file)) { files.push(c.file) }
            }
            for file in files
            {
                const group: Row = Row::create("file:" + file, file).icon("text-x-generic")
                for c in this.cases
                {
                    if (c.file == file) { group.child(this.rowOf(c)) }
                }
                rows.push(group)
            }
            var index: Int64 = 0
            for message in this.errors
            {
                rows.push(Row::create("error:" + index.toString(), message.split("\n")[0]).icon("dialog-error").toolTip(message))
                index = index + 1
            }
            this.model.reset(rows)
            for file in files { ItemView::of(this.window.mount, "tests").expand("file:" + file, true) }
            this.window.store.set("tests.summary", this.summary())
            this.window.store.setInt("tests.failed", this.count("failed"))
        }

        /** The row of a test; a failed one carries its message lines. */
        fn rowOf(c: TestCase) -> Row
        {
            var time: String = ""
            if (c.status == "passed" || c.status == "failed") { time = c.millis.toString() + " ms" }
            const row: Row = Row::create(c.id(), c.title()).icon(c.icon()).cell(c.status).cell(time).toolTip(c.className + "::" + c.method + " (" + c.file + ":" + c.line.toString() + ")")
            if (c.status == "failed")
            {
                var n: Int64 = 0
                for line in c.message.split("\n")
                {
                    if (line.trim() != "" && n < 40)
                    {
                        row.child(Row::create("detail:" + c.id() + "@" + n.toString(), line).icon("go-next"))
                    }
                    n = n + 1
                }
            }
            return row
        }

        /** Opens the place a row stands for: the location in a failure line, otherwise the test method. */
        fn visit(id: String) -> Nothing
        {
            if (id.startsWith("file:") || id.startsWith("error:")) { return }
            const c: TestCase = this.caseOfRow(id)
            if (c.file == "") { return }
            if (id.startsWith("detail:"))
            {
                const lines: List<String> = c.message.split("\n")
                const n: Int64 = id.substring(id.lastIndexOf("@") + 1, id.len()).toInt()
                if (n < lines.len())
                {
                    const found: BuildProblem = ProblemParser::parseText(lines[n], "")
                    if (found.line > 0 && found.path != "")
                    {
                        this.documents.openAt(found.path, found.line - 1, TestExplorer::zero(found.column))
                        return
                    }
                }
            }
            this.documents.openAt(c.file, TestExplorer::zero(c.line), TestExplorer::zero(c.column))
        }

        /** A one-based coordinate as the editor's zero-based one. */
        fnc zero(value: Int64) -> Int64
        {
            if (value <= 1) { return 0 }
            return value - 1
        }
    }
}

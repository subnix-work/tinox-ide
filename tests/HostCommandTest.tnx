import tinox.ide.build.HostCommand

class HostCommandTest
{
    @Test("native tasks keep their exact argument list")
    fn testNative() -> Bool
    {
        const argv: List<String> = HostCommand::wrap(["/tmp/program", "a b", "$(touch nope)"], "/tmp", ["A=B"], false)
        return argv.len() == 3 && argv[0] == "/tmp/program" && argv[1] == "a b" && argv[2] == "$(touch nope)"
    }

    @Test("Flatpak build tasks use host tools with separate cwd and environment arguments")
    fn testHostTool() -> Bool
    {
        const argv: List<String> = HostCommand::wrap(["/app/bin/tinox", "build", "a b.tnx"], "/home/a project", ["A=b c", "EMPTY=", "REMOVE"], true)
        return argv.len() == 11 && argv[0] == "/usr/bin/flatpak-spawn" && argv[1] == "--host" && argv[2] == "--watch-bus" &&
            argv[3] == "--directory=/home/a project" && argv[4] == "--env=A=b c" && argv[5] == "--env=EMPTY=" && argv[6] == "--unset-env=REMOVE" &&
            argv[7] == "--" && argv[8] == "tinox" && argv[9] == "build" && argv[10] == "a b.tnx"
    }

    @Test("Flatpak run tasks execute the host artifact without changing or interpreting arguments")
    fn testHostArtifact() -> Bool
    {
        const argv: List<String> = HostCommand::wrap(["/home/project with spaces/app", "; exit 1"], "/home/project with spaces", [], true)
        return argv.len() == 7 && argv[4] == "--" && argv[5] == "/home/project with spaces/app" && argv[6] == "; exit 1"
    }
}

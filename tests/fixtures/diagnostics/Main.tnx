import tinox.core.json
import tinox.core.process.Process
import tinox.ide.IdeApp
import tinox.ide.editor.OpenFile
import tinox.ide.kde.App
import tinox.ide.kde.Bridge
import tinox.ide.kde.Command
import tinox.ide.kde.Event
import tinox.ide.kde.EventLoop
import tinox.ide.ui.Diagnostic
import tinox.ide.ui.Position
import tinox.ide.ui.Utf16

class Main
{
    fnc main() -> Int32
    {
        return App::run("tinoxide", "Tinox Diagnostics Smoke", (events: EventLoop) => Main::logic(events))
    }

    fnc logic(events: EventLoop) -> Int32
    {
        var results: List<Bool> = []
        events.onType("core.ready", (event: Event) => Main::check(events, results))
        events.run()
        if (results.len() != 1 || !results[0]) { return 1 }
        return 0
    }

    fnc expect(condition: Bool, message: String) -> Nothing
    {
        if (!condition) { throw message }
    }

    fnc wait(app: IdeApp, predicate: fnc(IdeApp) -> Bool, timeout: Int64) -> Bool
    {
        const start: Int64 = Bridge::nowNs()
        while (!predicate(app) && (Bridge::nowNs() - start) / 1000000 < timeout)
        {
            app.events.pump(10)
        }
        return predicate(app)
    }

    fnc completion(app: IdeApp, file: OpenFile) -> Nothing
    {
        const source: String = "class Box\n{\n    fn count() -> Int64 { return 1 }\n}\nclass Main\n{\n    fnc main() -> Int32\n    {\n        const box: Box = Box {}\n        box.\n        return 0\n    }\n}\n"
        const report: Int64 = app.language.reports
        file.doc.setText(source)
        Main::expect(Main::wait(app, (a: IdeApp) => a.language.client.documents.get(Utf16::uri(file.path)).text == source && a.language.reports > report, 5000), "completion source was not synchronized")
        file.views[0].setCursor(Position::create(9, 12))
        app.events.pump(0)
        file.views[0].requestCompletion()
        Main::expect(Main::wait(app, (a: IdeApp) => Main::hasCompletion(file.views[0].id(), "count"), 5000), "type-aware member completion did not reach KTextEditor: " + Json::stringify(Bridge::query(Command::named("editor.debug.completionState").target(file.views[0].id()).build())) + " pending=" + app.language.assistance.pending.len().toString())
        println("assistance: real tinox-lsp member completion reached the native model")
    }

    fnc hasCompletion(view: Int64, label: String) -> Bool
    {
        const state = Bridge::query(Command::named("editor.debug.completionState").target(view).build())
        for item in state.getField("labels").asList() { if (item.getString() == label) { return true } }
        return false
    }

    fnc check(events: EventLoop, results: List<Bool>) -> Nothing
    {
        const app: IdeApp = IdeApp::start(events)
        try
        {
            const file: OpenFile = app.documents.open(Process::env("TINOX_DIAGNOSTICS_FILE"))
            app.language.start()
            Main::expect(Main::wait(app, (a: IdeApp) => a.language.connected && a.language.client.state == "ready" && a.language.reports > 0, 10000), "server did not initialize and publish")
            const start: Int64 = Bridge::nowNs()
            file.doc.setText("class Main\n{\n    fn broken( -> Nothing {}\n}\n")
            Main::expect(Main::wait(app, (a: IdeApp) => a.store.getInt("problems.errors") > 0, 5000), "syntax error was not published")
            const latency: Int64 = (Bridge::nowNs() - start) / 1000000
            Main::expect(latency < 300, "syntax diagnostic latency exceeded 300 ms: " + latency.toString())
            const diagnostics: List<Diagnostic> = file.doc.diagnostics("lsp")
            Main::expect(diagnostics.len() == app.store.getInt("problems.total"), "editor and problems count disagree")
            Main::expect(Bridge::query(Command::named("editor.debug.marks").target(file.doc.id()).build()).getField("marks").asTable().keys().len() > 0, "gutter has no mark")
            const hint = Bridge::query(Command::named("editor.debug.hint").target(file.doc.id()).raw("position", diagnostics[0].range.start.toJson()).build()).getField("text").getString()
            Main::expect(hint != "", "diagnostic hover is empty")
            app.registry.execute("problems.next")
            app.language.client.transport.stop()
            Main::expect(Main::wait(app, (a: IdeApp) => a.language.client.state == "backoff", 5000), "server loss did not enter backoff")
            Main::expect(app.store.getInt("problems.total") == 0 && file.doc.diagnostics("lsp").len() == 0, "server loss retained diagnostics")
            Main::expect(Main::wait(app, (a: IdeApp) => a.language.client.state == "ready" && a.store.getInt("problems.errors") > 0, 10000), "server restart did not restore diagnostics")
            const report: Int64 = app.language.reports
            const fixed: Int64 = Bridge::nowNs()
            file.doc.setText("class Main\n{\n}\n")
            Main::expect(Main::wait(app, (a: IdeApp) => a.language.reports > report && a.store.getInt("problems.total") == 0, 5000), "fix did not clear both views")
            const fixLatency: Int64 = (Bridge::nowNs() - fixed) / 1000000
            Main::expect(fixLatency < 300, "fixed diagnostic latency exceeded 300 ms: " + fixLatency.toString())
            Main::expect(file.doc.diagnostics("lsp").len() == 0, "editor retained stale diagnostics")
            Main::completion(app, file)
            app.documents.discard(file)
            Main::expect(app.language.paths.keys().len() == 0, "closed file remains synchronized")
            Main::expect(events.failureCount() == 0, "an event-loop handler failed")
            for line in app.logger.recent
            {
                Main::expect(!line.contains("WARN") && !line.contains("ERROR"), "unexpected application warning: " + line)
            }
            println("diagnostics: error " + latency.toString() + " ms; fix " + fixLatency.toString() + " ms; tree, editor, gutter, hover, restart and close agree")
            results.push(true)
        }
        catch (e: String)
        {
            printStderr("diagnostics smoke failed: " + e)
            results.push(false)
        }
        app.quit()
    }
}

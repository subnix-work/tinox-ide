import tinox.core.process.Process
import tinox.ide.IdeApp
import tinox.ide.editor.OpenFile
import tinox.ide.kde.App
import tinox.ide.kde.Bridge
import tinox.ide.kde.Command
import tinox.ide.kde.Event
import tinox.ide.kde.EventLoop
import tinox.ide.ui.Js

class Main
{
    fnc main() -> Int32
    {
        return App::run("tinoxide", "Tinox Debugger Smoke", (events: EventLoop) => Main::logic(events))
    }

    fnc logic(events: EventLoop) -> Int32
    {
        const results: List<Bool> = []
        events.onType("core.ready", (event: Event) => Main::check(events, results))
        events.run()
        if (results.len() != 1 || !results[0]) { return 1 }
        return 0
    }

    fnc expect(ok: Bool, message: String) -> Nothing
    {
        if (!ok) { throw message }
    }

    fnc wait(app: IdeApp, predicate: fnc(IdeApp) -> Bool, timeout: Int64) -> Bool
    {
        const start: Int64 = Bridge::nowNs()
        while (!predicate(app) && (Bridge::nowNs() - start) / 1000000 < timeout) { app.events.pump(10) }
        return predicate(app)
    }

    /** The 1-based line of the frame the debugger shows. */
    fnc line(app: IdeApp) -> Int64
    {
        if (app.debug.frames.len() == 0) { return 0 }
        return app.debug.frames[app.debug.frameIndex].getField("line").getInt()
    }

    /** The stopped state with a fully drawn frame: locals arrived after the stack. */
    fnc settled(app: IdeApp) -> Bool
    {
        return app.store.getBool("debug.stopped") && app.debug.drawn && app.debug.frames.len() > 0
    }

    fnc local(app: IdeApp, name: String) -> String
    {
        for entry in app.debug.shown
        {
            if (entry.startsWith(name + " = ")) { return entry.substring(name.len() + 3, entry.len()) }
        }
        return "<missing>"
    }

    fnc executionLine(file: OpenFile) -> Int64
    {
        const marks = Bridge::query(Command::named("editor.debug.marks").target(file.doc.id()).build()).getField("marks").asTable()
        for key in marks.keys()
        {
            if ((marks.get(key).getInt() / 16) % 2 == 1) { return key.toInt() }
        }
        return -1
    }

    fnc check(events: EventLoop, results: List<Bool>) -> Nothing
    {
        const app: IdeApp = IdeApp::start(events)
        try
        {
            const root: String = Process::env("TINOX_DEBUG_ROOT")
            app.store.set("workspace.path", root)
            app.store.setBool("workspace.open", true)
            app.build.workspaceChanged(root)
            const file: OpenFile = app.documents.open(root + "/Main.tnx")
            // A click in the gutter: the bridge reports it and the service keeps the line.
            Bridge::query(Command::named("editor.debug.toggleBreakpoint").target(file.doc.id()).int("line", 4).build())
            Main::expect(Main::wait(app, (a: IdeApp) => a.debug.breakpoints.has(file.path, 4), 5000), "the gutter click did not reach the breakpoint set")

            app.registry.execute("debug.start")
            Main::expect(Main::wait(app, (a: IdeApp) => Main::settled(a), 180000), "the program never stopped at the breakpoint (status: " + app.store.get("status.message") + ", build active: " + app.build.active.toString() + ", live: " + app.debug.live.toString() + "): " + app.debug.transcript)
            Main::expect(Main::line(app) == 5, "stopped at line " + Main::line(app).toString() + " instead of 5")
            Main::expect(app.debug.frames[0].getField("name").getString().contains("square"), "the top frame is " + app.debug.frames[0].getField("name").getString())
            Main::expect(Main::local(app, "n") == "7", "n is " + Main::local(app, "n") + ", the locals are " + app.debug.shown.len().toString())
            Main::expect(Main::executionLine(file) == 4, "the editor does not mark the stop line")

            app.registry.execute("debug.stepOver")
            Main::expect(Main::wait(app, (a: IdeApp) => Main::settled(a) && Main::line(a) == 6, 30000), "step over did not reach line 6: " + app.debug.transcript)
            Main::expect(Main::local(app, "result") == "49", "result is " + Main::local(app, "result") + ", locals: " + Js::join(app.debug.shown, "; ") + ", console: " + app.debug.transcript)

            app.registry.execute("debug.continue")
            Main::expect(Main::wait(app, (a: IdeApp) => !a.store.getBool("debug.active"), 30000), "the session did not end when the program ended")
            Main::expect(app.debug.transcript.contains("The program exited with status 0"), "no exit status in the console: " + app.debug.transcript)
            Main::expect(Main::executionLine(file) == -1, "the execution mark stayed after the session")
            Main::expect(app.debug.breakpoints.has(file.path, 4), "the breakpoint was lost with the session")
            Main::expect(events.failureCount() == 0, "an event-loop handler failed")
            println("debugger: gutter breakpoint, stop with call stack and locals, step over, continue and exit passed")
            results.push(true)
        }
        catch (e: String)
        {
            printStderr("debugger smoke failed: " + e)
            app.debug.shutdown()
            results.push(false)
        }
        app.quit()
    }
}

import tinox.ide.kde.Event

class EventTest
{
    @Test("the envelope is parsed once")
    fn testEnvelope() -> Bool
    {
        const ev: Event = Event::parse("{\"type\":\"widget.clicked\",\"seq\":12,\"t_ns\":99,\"target\":5,\"x\":1}")
        return ev.type == "widget.clicked" && ev.seq == 12 && ev.tNs == 99 && ev.target == 5
    }

    @Test("an event without a target has target 0")
    fn testNoTarget() -> Bool
    {
        const ev: Event = Event::parse("{\"type\":\"core.ready\",\"seq\":1,\"t_ns\":2}")
        return ev.target == 0
    }

    @Test("typed accessors read the payload")
    fn testAccessors() -> Bool
    {
        const ev: Event = Event::parse("{\"type\":\"editor.changed\",\"seq\":3,\"t_ns\":4,\"target\":9,\"text\":\"abc\",\"line\":7,\"dirty\":true}")
        return ev.has("text") && !ev.has("missing") && ev.str("text") == "abc" && ev.int("line") == 7 && ev.bool("dirty")
    }

    @Test("malformed events are rejected with a reason")
    fn testMalformed() -> Bool
    {
        var rejected: Int64 = 0
        try { Event::parse("[1,2]") } catch (e: String) { rejected = rejected + 1 }
        try { Event::parse("{\"seq\":1}") } catch (e: String) { rejected = rejected + 1 }
        return rejected == 2
    }
}
